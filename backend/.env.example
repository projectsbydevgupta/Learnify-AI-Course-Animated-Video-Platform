# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aicourse_db

# LLM & AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: TypeSafe Jev Guardrails (defaults to local fast System One model if empty)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENABLED=true

# Optional: Redis for async task queue (defaults to redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
